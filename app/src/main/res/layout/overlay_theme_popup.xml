<?xml version="1.0" encoding="utf-8"?>
<!-- The settings popup - a small, freely-draggable card (its own overlay
     window; see VolumeOverlayService.showThemePopup()/onDragHandleTouch()),
     centered on screen the first time it's opened and remembering wherever
     it was last dragged to after that. Three tabs: Theme (24 colors + the
     Dynamic checkbox), Size (popup/panel dimensions), Conf (volume tiers). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel_card"
    android:elevation="10dp">

    <!-- Header: title, drag handle, close. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/dragHandle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_round_button"
            android:src="@drawable/ic_drag"
            android:scaleType="center"
            android:contentDescription="Drag to move" />

        <ImageButton
            android:id="@+id/themeClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_round_button"
            android:src="@drawable/ic_close"
            android:scaleType="center"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Tab row: Theme / Size / Conf. -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tabTheme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Theme"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/cream"
            android:background="@drawable/bg_done_button" />

        <TextView
            android:id="@+id/tabSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Size"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#8A7A5C"
            android:background="@drawable/bg_small_button" />

        <TextView
            android:id="@+id/tabConf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Conf"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#8A7A5C"
            android:background="@drawable/bg_small_button" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14000000" />

    <FrameLayout
        android:id="@+id/tabContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ================= THEME TAB ================= -->
        <LinearLayout
            android:id="@+id/themeTabContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="230dp">

                <GridLayout
                    android:id="@+id/themeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:padding="8dp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp">

                <CheckBox
                    android:id="@+id/dynamicCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Dynamic"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Checked: color follows volume, theme color to red at max. Unchecked: one flat theme color everywhere."
                android:textColor="#8A7A5C"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="#0A000000">

                <TextView
                    android:id="@+id/themeCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Original"
                    android:textColor="#8A7A5C"
                    android:textSize="10sp"
                    android:textAllCaps="true" />

                <Button
                    android:id="@+id/themeDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Done"
                    android:textAllCaps="false"
                    android:textColor="@color/cream"
                    android:background="@drawable/bg_done_button" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= SIZE TAB ================= -->
        <LinearLayout
            android:id="@+id/sizeTabContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/popupSizeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Popup size: 260dp"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/popupSizeSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="160"
                android:progress="80" />

            <TextView
                android:id="@+id/panelWidthLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Volume panel width: 150dp"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/panelWidthSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="150"
                android:progress="40" />

            <TextView
                android:id="@+id/panelHeightLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Volume panel height: 150dp"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/panelHeightSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="170"
                android:progress="60" />
        </LinearLayout>

        <!-- ================= CONF TAB ================= -->
        <LinearLayout
            android:id="@+id/confTabContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/confMaxLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Max volume supported: 40"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/confMaxSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="30" />

            <TextView
                android:id="@+id/confLimitLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Limited to: 25"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/confLimitSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="39"
                android:progress="24" />

            <TextView
                android:id="@+id/confSlowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="When go slowly: 20"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/confSlowSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="25"
                android:progress="20" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
