<?xml version="1.0" encoding="utf-8"?>
<!-- The expanded panel: volume readout (5s-hold opens the theme popup),
     the EQ-segments bar+ball, the nudge arrow, and the collapse button.
     Root is a FrameLayout so the theme popup can sit on top of the card
     inside this same overlay window instead of needing a third window. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/panelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="8dp"
        android:background="@drawable/bg_panel_card"
        android:padding="14dp"
        android:gravity="center_horizontal">

        <!-- Volume readout: hold 5s to open the color theme popup. -->
        <LinearLayout
            android:id="@+id/readoutRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/volNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="@color/ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/volMax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="3dp"
                    android:text="/25"
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/holdProgressTrack"
                android:layout_width="90dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="#1A000000">

                <View
                    android:id="@+id/holdProgressFill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/accent"
                    android:scaleX="0" />
            </FrameLayout>
            <!-- No visible hint text here on purpose - the hold-to-open
                 gesture is still exactly 2s (THEME_HOLD_MS), just silent;
                 holdProgressTrack/Fill above is the only feedback while
                 holding. -->
        </LinearLayout>

        <!-- Nudge arrow (shown only at volume >= 20) + the EQ bar/ball. -->
        <ImageButton
            android:id="@+id/nudgeBtn"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_small_button"
            android:src="@drawable/ic_chevron"
            android:scaleType="centerInside"
            android:contentDescription="Push past 20"
            android:visibility="invisible" />

        <!-- match_parent, not a fixed 40dp column - most forms (Form tab)
             are a narrow centered bar like before, but round ones (Dial,
             Speedometer, Ring) need the panel's actual width to draw a
             properly sized circle/arc. EqBarView centers narrow forms
             itself; see its formsUseFullWidth(). -->
        <com.fuzz.volumehu.widget.EqBarView
            android:id="@+id/eqBar"
            android:layout_width="match_parent"
            android:layout_height="150dp" />

        <!-- Collapse (retract) arrow: rotated in code to point at whichever
             edge the panel is docked to. Square, so the fully-rounded
             bg_small_button (see tintSmallButton()) renders as a true
             circle instead of an oblong pill. -->
        <ImageButton
            android:id="@+id/collapseBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_small_button"
            android:src="@drawable/ic_chevron"
            android:scaleType="centerInside"
            android:contentDescription="Collapse panel" />
    </LinearLayout>

</FrameLayout>
