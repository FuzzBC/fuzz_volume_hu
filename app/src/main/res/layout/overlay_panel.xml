<?xml version="1.0" encoding="utf-8"?>
<!-- The expanded panel: volume readout (5s-hold opens the theme popup),
     the EQ-segments bar+ball, the nudge arrow, and the collapse button.
     Root is a FrameLayout so the theme popup can sit on top of the card
     inside this same overlay window instead of needing a third window. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="184dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/panelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="8dp"
        android:background="@drawable/bg_panel_card"
        android:padding="14dp"
        android:gravity="center_horizontal">

        <!-- Volume readout: hold 5s to open the color theme popup. -->
        <LinearLayout
            android:id="@+id/readoutRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/volNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="@color/ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/volMax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="3dp"
                    android:text="/25"
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/holdProgressTrack"
                android:layout_width="90dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="#1A000000">

                <View
                    android:id="@+id/holdProgressFill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/accent"
                    android:scaleX="0" />
            </FrameLayout>

            <TextView
                android:id="@+id/holdHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="hold 5s for colors"
                android:textColor="#A5936D"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <!-- Nudge arrow (shown only at volume >= 20) + the EQ bar/ball. -->
        <ImageButton
            android:id="@+id/nudgeBtn"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_small_button"
            android:src="@drawable/ic_chevron"
            android:scaleType="centerInside"
            android:contentDescription="Push past 20"
            android:visibility="invisible" />

        <com.fuzz.volumehu.widget.EqBarView
            android:id="@+id/eqBar"
            android:layout_width="40dp"
            android:layout_height="150dp" />

        <!-- Collapse arrow: rotated in code to point at whichever edge
             the panel is docked to. -->
        <ImageButton
            android:id="@+id/collapseBtn"
            android:layout_width="42dp"
            android:layout_height="26dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_small_button"
            android:src="@drawable/ic_chevron"
            android:scaleType="centerInside"
            android:contentDescription="Collapse panel" />
    </LinearLayout>

    <!-- Theme popup: 24 colors, previews live, stays open until Done. -->
    <FrameLayout
        android:id="@+id/themePopup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#7F140F08"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:background="@drawable/bg_panel_card"
            android:elevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Volume color"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/themeClose"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_round_button"
                    android:src="@drawable/ic_close"
                    android:scaleType="center"
                    android:contentDescription="Close" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <GridLayout
                    android:id="@+id/themeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:padding="8dp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="#0A000000">

                <TextView
                    android:id="@+id/themeCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Original"
                    android:textColor="#8A7A5C"
                    android:textSize="10sp"
                    android:textAllCaps="true" />

                <Button
                    android:id="@+id/themeDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Done"
                    android:textAllCaps="false"
                    android:textColor="@color/cream"
                    android:background="@drawable/bg_done_button" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
