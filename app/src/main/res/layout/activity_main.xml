<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/cream"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text=""
        android:textColor="@color/ink_dim"
        android:textSize="14sp"
        android:gravity="center" />

    <Button
        android:id="@+id/grantOverlayBtn"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/grant_overlay" />

    <Button
        android:id="@+id/toggleServiceBtn"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/start_overlay" />

    <Button
        android:id="@+id/batteryOptBtn"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/battery_opt_prompt" />

    <Button
        android:id="@+id/checkUpdateBtn"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/check_updates" />

    <Button
        android:id="@+id/viewTraceBtn"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:text="@string/view_trace_log" />

</LinearLayout>
