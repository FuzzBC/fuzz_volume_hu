<?xml version="1.0" encoding="utf-8"?>
<!-- canRequestFilterKeyEvents + flagRequestFilterKeyEvents intercept the
     hardware volume keys via onKeyEvent() - that's the actual "Block
     system volume popup" mechanism. typeWindowStateChanged is for
     identification only (see onAccessibilityEvent()'s doc): logging which
     window shows up right after a volume press, not acting on it - an
     earlier attempt to also dismiss that window via GLOBAL_ACTION_BACK was
     reverted (see VolumeKeyAccessibilityService's class doc), this only
     watches now. canRetrieveWindowContent stays false since only the
     event's own package/class name is read, never screen content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeNotificationStateChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
